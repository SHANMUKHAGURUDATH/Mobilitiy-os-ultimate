VITE_API_BASE=http://localhost:4000

# Google Cloud Console -> Credentials -> Create API key -> restrict to
# HTTP referrers (your domain + localhost) -> restrict to:
#   Maps JavaScript API, Places API, Directions API
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud Console (Maps -> Map Management)
# if you want cloud-based map styling. Leave blank to use default styling.
VITE_GOOGLE_MAPS_MAP_ID=

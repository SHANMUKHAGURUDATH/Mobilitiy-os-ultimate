PORT=4000
NODE_ENV=development

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret

# --- Database (required for every DB-backed route) ---
# Local Postgres example: postgresql://postgres:postgres@localhost:5432/mobilityos
DATABASE_URL=

# --- Google Maps (server-side key: Routes/Places, kept OFF the frontend bundle) ---
GOOGLE_MAPS_SERVER_API_KEY=

# --- AI microservice (ai-service/) ---
AI_SERVICE_URL=http://localhost:8000

# --- File storage ---
# local = backend/uploads/ (fine for dev, NOT durable on serverless hosts)
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, ...)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL_BASE=

# --- Demo mode ---
# true  = /ws/simulation runs and generates fake fleet movement for demos
# false = only real GPS posts to /api/vehicles/:id/location move markers
SIMULATION_MODE=false
